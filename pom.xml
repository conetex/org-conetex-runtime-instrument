<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.conetex.runtime.instrument</groupId>
    <artifactId>parent</artifactId>
    <version>0.0.1</version>

    <name>org.conetex.runtime.instrument</name>
    <description>org.conetex.runtime.instrument</description>

    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>18</maven.compiler.source>
        <maven.compiler.target>18</maven.compiler.target>
        <maven.compiler.release>18</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
    </properties>

    <modules>
        <module>interfaces</module>
        <module>counter</module>
        <module>collection</module>
        <module>metrics-cost</module>
        <module>metrics-cost-unnamed</module>
        <module>agent</module>
        <module>tests</module>
        <module>example</module>
    </modules>

    <url>https://github.com/conetex/org-conetex-runtime-instrument</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/conetex/org-conetex-runtime-instrument</url>
        <connection>scm:git:https://github.com/conetex/org-conetex-runtime-instrument.git</connection>
        <developerConnection>scm:git:git@github.com/conetex/org-conetex-runtime-instrument.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>matthias-franke</id>
            <name>Matthias Franke</name>
        </developer>
    </developers>

    <build>
        <plugins>

            <!-- JAR (needed for publish) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <!--<goal>jar</goal>-->
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc (needed for central-publishing) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>

                <executions>
                    <!-- for central-publishing -->
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Deploy / Publish (central-publishing) -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <excludeArtifacts>

                        <artifact>example</artifact>

                        <artifact>test-parent</artifact>
                        <!-- tests modules -->
                        <artifact>empty</artifact>
                        <artifact>integration</artifact>
                        <artifact>jar</artifact>
                        <artifact>jar-blocked</artifact>
                        <artifact>jar-module</artifact>
                        <!-- tests modules -->

                    </excludeArtifacts>
                </configuration>
            </plugin>

            <!-- JaCoCo java code coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <!-- start the jacoco agent before tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- create HTML-report after tests -->
                    <execution> <!-- per Module -->
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <!-- global <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>-->
                </executions>
            </plugin>

            <!-- DOC Asciidoctor -->
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <version>3.2.0</version>

                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-pdf</artifactId>
                        <version>2.3.19</version>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-diagram</artifactId>
                        <version>3.0.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-diagram-plantuml</artifactId>
                        <version>1.2025.3</version>
                    </dependency>
                </dependencies>

                <executions>
                    <execution>
                        <id>generate-docs</id>

                        <phase>generate-resources</phase>

                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
<!--
https://conetex.github.io/org-conetex-runtime-instrument/apidocs/agent/org.conetex.runtime.instrument.agent/org/conetex/runtime/instrument/agent/Instrument.AgentLog.html
https://conetex.github.io/org-conetex-runtime-instrument/jacoco/collection/index.html
https://conetex.github.io/org-conetex-runtime-instrument/asciidoc/
https://conetex.github.io/org-conetex-runtime-instrument/latest/raw/architecture.md

-->
                        <configuration>

                            <requires>
                                <require>asciidoctor-diagram</require>
                            </requires>

                            <!-- Quelle -->
                            <sourceDirectory>
                                ${project.basedir}/src/site/asciidoc
                            </sourceDirectory>

                            <!-- Startdatei
                            <sources>
                                <include>index.adoc</include>
                            </sources>-->

                            <!-- Ziel -->
                            <outputDirectory>
                                ${project.build.directory}/site/asciidoc
                            </outputDirectory>

                            <!-- Backend -->
                            <backend>html5</backend>

                            <!--
                            <includes>
                                <include>**/*.adoc</include>
                            </includes>
                            -->

                            <attributes>
                                <toc>left</toc>
                                <icons>font</icons>
                                <source-highlighter>highlightjs</source-highlighter>
                                <plantuml-format>svg</plantuml-format>

                                <sectnums>true</sectnums>
                                <plantuml-format>svg</plantuml-format>
                                <!--
                                <imagesoutdir>${project.build.directory}/siteAdoc/diagrams</imagesoutdir>
-->
                            </attributes>


                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- DOC stuff we do not need to transform or render -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>

                <executions>

                    <execution>
                        <id>collect-javadocs</id>

                        <!-- WICHTIG -->
                        <inherited>false</inherited>

                        <phase>verify</phase>

                        <goals>
                            <goal>copy-resources</goal>
                        </goals>

                        <configuration>
                            <outputDirectory>
                                ${project.build.directory}/site/raw
                            </outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/src/site/raw
                                    </directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- DOC
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>4.0.0-M13</version>
                <configuration>
                    <siteDirectory>src/site</siteDirectory>
                </configuration>
            </plugin> -->

            <!-- DOC plantuml
            <plugin>
                <groupId>com.github.jeluard</groupId>
                <artifactId>plantuml-maven-plugin</artifactId>
                <version>1.2</version>
                <inherited>false</inherited>

                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.plantuml</groupId>
